# =============================================================================
# Enterprise Data Agent — Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# --- OpenAI / LLM -----------------------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o

# --- Oracle HQ Warehouse ----------------------------------------------------
ORACLE_HQ_HOST=your-oracle-hq-host
ORACLE_HQ_PORT=1521
ORACLE_HQ_SERVICE_NAME=ORCL
ORACLE_HQ_USER=readonly_user
ORACLE_HQ_PASSWORD=your-secure-password

# --- Oracle East Warehouse ---------------------------------------------------
ORACLE_EAST_HOST=your-oracle-east-host
ORACLE_EAST_PORT=1521
ORACLE_EAST_SERVICE_NAME=ORCL
ORACLE_EAST_USER=readonly_user
ORACLE_EAST_PASSWORD=your-secure-password

# --- Oracle West Warehouse ---------------------------------------------------
ORACLE_WEST_HOST=your-oracle-west-host
ORACLE_WEST_PORT=1521
ORACLE_WEST_SERVICE_NAME=ORCL
ORACLE_WEST_USER=readonly_user
ORACLE_WEST_PASSWORD=your-secure-password

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Agent Service -----------------------------------------------------------
AGENT_SERVICE_URL=http://agent-service:8001
AGENT_TIMEOUT_SECONDS=120
